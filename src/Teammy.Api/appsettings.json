{
  "AllowedHosts": "*",
  "Authentication": {
    "DemoEnabled": false,
    "RoleClaimType": "roles"
  },
  "Database": {
    "Provider": "PostgreSql",
    "Initialize": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "json"
    }
  }
}
